conky.config = {
	cpu_avg_samples = 2,
	diskio_avg_samples = 10,
	double_buffer = true,
	net_avg_samples = 2,
	update_interval = 1,

	alignment = 'top_right',
	gap_x = 12,
	gap_y = 32,
	minimum_height = 868,
	minimum_width = 760,
	maximum_width = 760,

	font = 'Noto Mono:size=11:regular',
	override_utf8_locale = true,
	short_units = true,
	use_xft = true,
	xftalpha = 1,

	own_window = yes,
	own_window_argb_value = 15,
	own_window_argb_visual = yes,
	own_window_class = 'Conky',
	own_window_transparent = yes,
	own_window_title = 'system_conky',
	own_window_type = 'desktop',

  lua_load = '~/conky_hexagon/clock_hexagon.lua',
	lua_draw_hook_pre = 'draw_clock',
  lua_draw_hook_post = 'startup_post',
  lua_shutdown_hook = 'shutdown',
  lua_startup_hook = 'startup'
}

